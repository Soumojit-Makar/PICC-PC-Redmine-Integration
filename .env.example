# ==============================================================================
# PICC-PC-Redmine-Integration - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens
SERVER_PORT=8080

# Active Spring Profile (e.g., main, dev, local)
SPRING_PROFILES_ACTIVE=main

# ------------------------------------------------------------------------------
# 2. Redmine REST API Integration (Primary Client)
# ------------------------------------------------------------------------------
# Feign client identifier
FEIGN_NAME=redmine-client

# Base URL of your primary Redmine instance (e.g., http://localhost:3000)
FEIGN_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Secondary / Support Redmine Client
# ------------------------------------------------------------------------------
# Feign client identifier for support workflows
FEIGN_SUPPORT_NAME=redmine-support-client

# Base URL for secondary/support Redmine instance
FEIGN_SUPPORT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Role Mapping & Default Membership
# ------------------------------------------------------------------------------
# Default role ID assigned when onboarding users into projects:
# 1=Non member, 2=Anonymous, 3=Manager, 4=Developer, 5=Reporter, 6=DevOps-Architect, 7=Tech Lead, 8=DevOps-Engineer
REDMINE_ROLE=4

# ------------------------------------------------------------------------------
# 5. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
# URL for centralized Spring Cloud Config Server (if used)
CONFIG_SERVER_URL=http://localhost:8888
